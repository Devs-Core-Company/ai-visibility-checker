{
 "tool": "unlighthouse",
 "source": "Same Lighthouse 13.5.0 audit ids as mappings/lighthouse.json (Unlighthouse runs Lighthouse per route; agentic-browsing is not in its default categories)",
 "version": "@unlighthouse/cli 0.19.1 (lighthouse 13.5.0)",
 "rule": "A native id is mapped to a ground-truth type (or alt_type) when its finding clearly names the same problem. Written from the tool catalogue, not from run output. Same standard for every tool.",
