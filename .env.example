# AI Visibility Checker environment variables. Copy to .env (never commit .env).
# Every value is optional. Keys can also be saved with `avc init`, `avc connect`
# or the dashboard Settings page, which store them in ~/.avc/config.json (mode 600).

# Where audits, history, tokens and rollback snapshots are stored. Default ~/.avc
AVC_DATA_DIR=

# --- AI visibility (pick one gateway key, or any provider keys) ---
# Vercel AI Gateway: one key for every engine
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=
# Fake answers, no spend (testing)
AVC_LLM_MOCK=
# Spend caps in USD (defaults: 3 per run, 30 per month)
AVC_MAX_RUN_USD=
AVC_MAX_MONTH_USD=

# --- Google (Search Console, GA4, PageSpeed) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Or a service-account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=
PSI_API_KEY=
# Set to off to skip PageSpeed Insights entirely (no requests to Google)
AVC_PSI=

# --- Bing Webmaster Tools ---
BING_WEBMASTER_API_KEY=

# --- WordPress auto-fix (application password for the user in avc.config.json) ---
AVC_WP_APP_PASSWORD=

# --- Alerts ---
AVC_WEBHOOK_URL=
AVC_ALERT_EMAIL=
AVC_SMTP_URL=
AVC_SMTP_FROM=

# --- Dashboard ---
AVC_PORT=
AVC_HOST=

# --- JavaScript rendering: path to Chrome or Chromium if not found automatically ---
AVC_CHROME_PATH=
